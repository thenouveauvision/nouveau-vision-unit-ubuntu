# Generated by the NVU Dashboard installer.
# DASHBOARD_HOST is supplied by the node operator.

<VirtualHost *:80>
    ServerName DASHBOARD_HOST

    ProxyRequests Off
    ProxyPreserveHost On

    ProxyPass        / unix:/run/nvu-dashboard/nvu-dashboard.sock|http://localhost/
    ProxyPassReverse / unix:/run/nvu-dashboard/nvu-dashboard.sock|http://localhost/

    ErrorLog ${APACHE_LOG_DIR}/nvu-dashboard-error.log
    CustomLog ${APACHE_LOG_DIR}/nvu-dashboard-access.log combined
</VirtualHost>
